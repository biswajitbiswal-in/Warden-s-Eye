# ============================================================================
# SmartPPE — Warden's Eye (Backend Environment Template)
# Copy to `backend/.env` for local development. NEVER commit `.env` to Git.
# ============================================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smartppe_wardens_eye
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_BYTE_RANDOM_HEX_SECRET
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
CLIENT_URL=http://localhost:5173
ML_SERVICE_API_KEY=REPLACE_WITH_LOCAL_ML_SERVICE_API_KEY_PLACEHOLDER
RFID_COOLDOWN_SECONDS=10
INCIDENT_COOLDOWN_SECONDS=60
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=90
WARNING_GRACE_SECONDS=120
