# ============================================================================
# SmartPPE — Warden's Eye
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` (or `backend/.env`) for local development.
# 2. Replace the placeholder values below with your local configuration.
# 3. NEVER commit `.env` or real secrets, passwords, or API keys to Git.
# ============================================================================

# --- 1. Backend Application Configuration ---
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- 2. Database Configuration (MongoDB / Mongoose) ---
MONGODB_URI=mongodb://127.0.0.1:27017/smartppe_wardens_eye
DATABASE_URL=mongodb://127.0.0.1:27017/smartppe_wardens_eye

# --- 3. Human User Authentication (JWT & Password Hashing) ---
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_BYTE_RANDOM_HEX_SECRET
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- 4. ML Service & ESP32 Hardware Ingestion Security ---
ML_SERVICE_API_KEY=REPLACE_WITH_LOCAL_ML_SERVICE_API_KEY_PLACEHOLDER

# --- 5. Deduplication Cooldown, Grace Timer & Heartbeat Thresholds (Seconds) ---
RFID_COOLDOWN_SECONDS=10
INCIDENT_COOLDOWN_SECONDS=60
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=90
WARNING_GRACE_SECONDS=120

# --- 6. Private Evidence Storage Configuration ---
EVIDENCE_STORAGE_DIR=./storage/evidence
MAX_EVIDENCE_FILE_SIZE_MB=5

# --- 7. Frontend Configuration (When Applicable) ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_WS_BASE_URL=http://localhost:5000
